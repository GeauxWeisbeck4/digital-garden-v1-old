---
import BaseLayout from '../layouts/BaseLayout.astro';

const meta = {
	description: 'Learn more about Andrew and where you can find his work.',
	title: 'About',
};
---

<BaseLayout meta={meta}>
	<section class="mx-auto mt-6 flex flex-col px-4 py-6">
		<div class="max-w-6xl text-left">
			<h1 class="text-3xl font-bold pb-18 text-center">About WeisGarden</h1>

			<div class="grid lg:grid-cols-8">
				<div class="col-span-3 text-center">
					<img
						class="h-108 w-108 rounded-xl text-center mb-2"
						src="https://res.cloudinary.com/tar-heel-dev-studio/image/upload/t_logo-digital-garden/v1662777703/andrewlisa.jpg"
						alt="Andrew and his partner Lisa"
					/>
					<div class="mb-2">
						<h3 class="text-3xl text-sky-300 font-semibold pb-0.5">
							Andrew Weisbeck
						</h3>
						<p class="text-sm text-teal-300 pb-2">
							Software Developer, Entrepreneur, Writer
						</p>
						<img
							class="pb-4 justify-self-center"
							alt="Static Badge"
							src="https://img.shields.io/badge/Durham%2C_NC-NC?logo=googlemaps&color=white"
						/>
						<hr />
						<div class="flex flex-col gap-1">
							<h3 class="text-xl text-sky-300 font-semibold text-center pt-4">
								My Links
							</h3>
							<a
								href="https://geauxweisbeck4.deno.dev"
								class="text-teal-700 text-xl text-center hover:text-teal-500 pt-2"
								>Portfolio Website</a
							>
							<a
								href="https://tarheeldevstudio.netlify.app"
								class="text-teal-700 text-xl text-center hover:text-teal-500"
								>Tar Heel Dev Studio</a
							>
							<a href="https://substack.com/weismind" class="text-teal-700 text-center text-xl hover:text-teal-500">
								WeisMind Newsletter
							</a>
						</div>
					</div>

					<hr class="my-4 text-slate-500" />
					<h3 class="text-xl text-sky-300 font-semibold text-center">
						Find Me
					</h3>
					<p class="text-center justify-center flex flex-wrap gap-4 mt-2">
						<a href="https://github.com/geauxweisbeck4">
							<img
								alt="GitHub Static Badge"
								src="https://img.shields.io/badge/GitHub-geauxweisbeck4?logo=github&color=black&link=https%3A%2F%2Fgithub.com%2Fgeauxweisbeck4"
							/>
						</a>
						<a href="https://gitlab.com/geauxweisbeck4">
							<img
								alt="Static Badge"
								src="https://img.shields.io/badge/Gitlab-geauxweisbeck4?logo=gitlab&logoColor=orange&color=white&link=https%3A%2F%2Fgitlab.com%2Fgeauxweisbeck4"
							/>
						</a>
						<a href="https://codepen.io/geauxweisbeck4">
							<img
								alt="Static Badge"
								src="https://img.shields.io/badge/Codepen-geauxweisbeck4?logo=codepen&color=black&link=https%3A%2F%2Fcodepen.io%2Fgeauxweisbeck4"
							/>
						</a>
						<a href="https://replit.com/geauxweisbeck4">
