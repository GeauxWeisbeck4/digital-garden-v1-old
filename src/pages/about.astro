							/>
						</a>
						<a href="https://twitter.com/geauxweisbeck4">
							<img
								alt="Static Badge"
								src="https://img.shields.io/badge/Twitter-geauxweisbeck4?logo=x&color=black&link=https%3A%2F%2Fwww.twitter.com%2F%40geauxweisbeck4"
							/>
						</a>
						<a href="https://www.reddit.com/user/Tough_Horse_1502/">
