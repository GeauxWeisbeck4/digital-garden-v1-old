							<img
								alt="Static Badge"
								src="https://img.shields.io/badge/Hashnode-geauxweisbeck4?logo=hashnode&logoColor=blue&labelColor=white&color=blue&link=https%3A%2F%2Fhashnode.com%2F%40GeauxWeisbeck4"
							/>
						</a>
