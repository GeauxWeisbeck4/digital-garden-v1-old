{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"lib": [
			"es2022",
			"dom",
			"dom.iterable"
		],
		"paths": {
			"@/assets/*": [
				"./src/assets/*"
			],
			"@/components/*": [
				"./src/components/*"
			],
			"@/data/*": [
				"./src/data/*"
			],
			"@/layouts/*": [
				"./src/utils/*"
			],
			"@/types": [
				"./src/types.ts"
			],
			"@/site-config": [
				"./src/site.config.ts"
			]
		}
	},
	"include": [
		".astro/types.d.ts",
		"**/*",
		"./worker-configuration.d.ts"
	],
	"exclude": [
		"node_modules",
		"**/node_modules/*",
		".vscode",
		"dist"
	]
}